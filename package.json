{
  "name": "carrieraudit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm": "RUN_LLM_TESTS=1 vitest run tests/extraction/llm.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts && tsx scripts/generate-fixture-pdf.ts",
    "fixtures:generate:pdfs": "tsx scripts/generate-fixture-pdf.ts",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/client-textract": "^3.1058.0",
    "@hookform/resolvers": "^5.4.0",
    "@react-pdf/renderer": "^4.1.5",
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "inngest": "^3.27.5",
    "lucide-react": "^1.17.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.9.155",
    "posthog-js": "^1.378.1",
    "posthog-node": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "resend": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "8.5.10",
      "protobufjs@<=7.5.7": "7.5.8",
      "protobufjs@>=8.0.0 <=8.0.1": "8.2.0",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "rollup@>=3.0.0 <3.30.0": "3.30.0",
      "uuid@<11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.20.1": "8.20.1"
    }
  }
}
