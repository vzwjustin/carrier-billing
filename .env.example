# ---------------------------------------------------------------------------
# CarrierAudit — environment variables
# Copy to .env.local for local development. All keys are required for the app
# to boot (validated by src/env.ts) unless marked optional.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# AWS Textract (IAM user with TextractFullAccess)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: only needed for >5MB scanned PDFs that need async Textract OCR.
# Must be a private bucket in the same AWS_REGION.
AWS_TEXTRACT_S3_BUCKET=

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_ONE_TIME=
STRIPE_PRICE_ID_SUBSCRIPTION=

# Inngest (optional in dev — leave blank to use the local Inngest dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend (https://resend.com)
RESEND_API_KEY=

# Sentry build-time (optional — enables sourcemap upload + release tracking)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
